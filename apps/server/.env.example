# Copy to .env (gitignored). Bun loads it automatically.

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts every stored API key and token (AES-256-GCM). Never rotate without re-encrypting.
ENCRYPTION_KEY=

# postgres://… on Railway (reference ${{Postgres.DATABASE_URL}}).
# Locally: a directory for embedded PGlite (e.g. .data/db), or empty for in-memory.
DATABASE_URL=.data/db

PORT=3000
WEB_URL=http://localhost:3001
# Public URL of this server: instabox VMs call back to it.
PUBLIC_SERVER_URL=

# GitHub App (agentcall). Setup URL / callback: ${WEB_URL}/callback/github
# Webhook URL: ${PUBLIC_SERVER_URL}/github/events
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM; \n escapes are fine.
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Slack app. Redirect URL: ${WEB_URL}/callback/slack
# Event subscriptions URL: ${PUBLIC_SERVER_URL}/api/v1/slack/events
# (bot events: app_mention, message.channels, message.groups)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

WORKER_CONCURRENCY=4
TASK_TIMEOUT_MINUTES=45
